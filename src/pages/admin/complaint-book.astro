---
import DashboardShell from '../../components/private/DashboardShell.astro';
import ComplaintBookReview from '../../components/islands/ComplaintBookReview.tsx';
import { formatComplaintReference, formatDate, formatUsd } from '@luxus/shared';
import { requireRole } from '../../lib/auth';
import { apiFetch } from '../../lib/api';

const guard = requireRole(Astro, 'admin');
if (guard instanceof Response) return guard;
const session = guard;

const statusParam = (Astro.url.searchParams.get('status') ?? 'received') as
  'received' | 'in_review' | 'responded' | 'closed';

interface ComplaintEntry {
  id: string;
  entry_number: number;
  kind: 'reclamo' | 'queja';
  full_name: string;
  document_type: string;
  document_number: string;
  email: string;
  phone: string | null;
  address: string | null;
  is_minor: boolean;
  guardian_name: string | null;
  product_or_service: string;
  amount: number | null;
  detail: string;
  requested_action: string | null;
  status: string;
  response_text: string | null;
  responded_at: string | null;
  created_at: string;
}

let entries: ComplaintEntry[] = [];
try {
  const data = await apiFetch<{ entries: ComplaintEntry[] }>(
    `/v1/admin/complaint-book?status=${statusParam}`,
    { token: session.accessToken },
  );
  entries = data.entries;
} catch {
  entries = [];
}

const tabs = [
  { key: 'received', label: 'Recibidos' },
  { key: 'in_review', label: 'En revisión' },
  { key: 'responded', label: 'Respondidos' },
  { key: 'closed', label: 'Cerrados' },
];
---

<DashboardShell title="Libro de Reclamaciones" session={session}>
  <div class="mb-8">
    <h1 class="font-display text-[32px] leading-tight">Libro de Reclamaciones</h1>
    <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-ink-muted">
      Toda entrada exige respuesta en un plazo no mayor a 30 días calendario.
      Responder envía la constancia por correo al reclamante de inmediato.
    </p>
  </div>

  <nav class="mb-6 flex flex-wrap gap-1 border-b border-stone" aria-label="Filtro por estado">
    {tabs.map((tab) => (
      <a
        href={`/admin/complaint-book?status=${tab.key}`}
        aria-current={statusParam === tab.key ? 'page' : undefined}
        class:list={[
          'border-b-2 px-4 py-3 text-[12px] uppercase tracking-luxus transition-colors',
          statusParam === tab.key
            ? 'border-ink text-ink'
            : 'border-transparent text-ink-muted hover:text-ink',
        ]}
      >
        {tab.label}
      </a>
    ))}
  </nav>

  {entries.length === 0 ? (
    <p class="border border-stone bg-white p-8 text-[14px] text-ink-muted">
      No hay registros en este estado.
    </p>
  ) : (
    <ul class="space-y-4">
      {entries.map((entry) => (
        <li class="border border-stone bg-white">
          <div class="grid gap-8 p-6 lg:grid-cols-12">
            <div class="lg:col-span-3">
              <p class="text-[11px] uppercase tracking-luxus text-gold-dark">
                {entry.kind === 'reclamo' ? 'Reclamo' : 'Queja'} · {formatComplaintReference(entry.entry_number)}
              </p>
              <p class="mt-2 font-display text-[19px]">{entry.full_name}</p>
              <p class="mt-1 text-[13px] text-ink-muted">{entry.email}</p>
              {entry.phone && <p class="text-[13px] text-ink-muted">{entry.phone}</p>}
              <p class="mt-1 text-[13px] text-ink-muted">
                {entry.document_type} {entry.document_number}
              </p>
              {entry.is_minor && entry.guardian_name && (
                <p class="mt-1 text-[13px] text-ink-muted">Apoderado: {entry.guardian_name}</p>
              )}
              <p class="mt-3 text-[11px] uppercase tracking-luxus text-ink-muted/70">
                {formatDate(entry.created_at)}
              </p>
            </div>

            <div class="lg:col-span-5">
              <p class="text-[13px]"><strong class="text-ink-muted">Bien/servicio:</strong> {entry.product_or_service}</p>
              {entry.amount !== null && (
                <p class="mt-1.5 text-[13px]"><strong class="text-ink-muted">Monto:</strong> {formatUsd(entry.amount)}</p>
              )}
              <p class="mt-3 text-[13.5px] leading-relaxed text-ink">{entry.detail}</p>
              {entry.requested_action && (
                <p class="mt-3 border-l-2 border-stone-dark pl-3 text-[12.5px] italic text-ink-muted">
                  Pide: {entry.requested_action}
                </p>
              )}
              {entry.response_text && (
                <p class="mt-3 border-l-2 border-gold pl-3 text-[12.5px] leading-relaxed text-ink-muted">
                  <strong class="text-ink">Respuesta ({formatDate(entry.responded_at)}):</strong> {entry.response_text}
                </p>
              )}
            </div>

            <div class="lg:col-span-4">
              {statusParam === 'received' || statusParam === 'in_review' ? (
                <ComplaintBookReview client:visible entryId={entry.id} />
              ) : (
                <span class:list={[
                  'badge',
                  statusParam === 'responded' ? 'border-ink bg-ink text-white' : 'border-stone-dark text-ink-muted',
                ]}>
                  {statusParam === 'responded' ? 'Respondido' : 'Cerrado'}
                </span>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}
</DashboardShell>
