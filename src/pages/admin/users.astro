---
import DashboardShell from '../../components/private/DashboardShell.astro';
import UserRowActions from '../../components/islands/UserRowActions.tsx';
import { formatDate } from '@luxus/shared';
import { requireRole } from '../../lib/auth';
import { apiFetch } from '../../lib/api';

const guard = requireRole(Astro, 'admin');
if (guard instanceof Response) return guard;
const session = guard;

const q = Astro.url.searchParams.get('q') ?? '';
const roleFilter = Astro.url.searchParams.get('role') ?? '';

interface UserRow {
  id: string;
  email: string;
  full_name: string | null;
  role: string;
  membership_tier: string;
  kyc_status: string;
  is_suspended: boolean;
  created_at: string;
}

let users: UserRow[] = [];
let total = 0;
try {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (roleFilter) params.set('role', roleFilter);
  params.set('pageSize', '100');
  const data = await apiFetch<{ users: UserRow[]; total: number }>(
    `/v1/admin/users?${params.toString()}`,
    { token: session.accessToken },
  );
  users = data.users;
  total = data.total;
} catch {
  users = [];
}

const KYC_LABEL: Record<string, string> = {
  not_started: 'Sin iniciar',
  in_progress: 'En curso',
  submitted: 'Enviada',
  in_review: 'En revisión',
  approved: 'Aprobada',
  rejected: 'Rechazada',
  expired: 'Caducada',
};

---

<DashboardShell title="Usuarios" session={session}>
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-[32px] leading-tight">Usuarios</h1>
      <p class="mt-2 text-[14px] text-ink-muted">{total} en total</p>
    </div>

    <form method="GET" class="flex gap-2">
      <input
        type="search" name="q" defaultValue={q} placeholder="Buscar por nombre o correo"
        class="field w-64"
      />
      <select name="role" class="field w-40">
        <option value="">Todos los roles</option>
        <option value="buyer" selected={roleFilter === 'buyer'}>Comprador</option>
        <option value="seller" selected={roleFilter === 'seller'}>Vendedor</option>
        <option value="broker" selected={roleFilter === 'broker'}>Bróker</option>
        <option value="admin" selected={roleFilter === 'admin'}>Admin</option>
      </select>
      <button type="submit" class="btn-outline px-6">Buscar</button>
    </form>
  </div>

  {users.length === 0 ? (
    <p class="border border-stone bg-white p-8 text-[14px] text-ink-muted">Sin resultados.</p>
  ) : (
    <div class="overflow-x-auto border border-stone bg-white">
      <table class="w-full min-w-[52rem] text-left">
        <caption class="sr-only">Usuarios de la plataforma</caption>
        <thead>
          <tr class="border-b border-stone text-[10px] uppercase tracking-luxus text-ink-muted">
            <th scope="col" class="px-5 py-3.5 font-normal">Usuario</th>
            <th scope="col" class="px-5 py-3.5 font-normal">KYC</th>
            <th scope="col" class="px-5 py-3.5 font-normal">Membresía</th>
            <th scope="col" class="px-5 py-3.5 font-normal">Desde</th>
            <th scope="col" class="px-5 py-3.5 text-right font-normal">Rol y estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone">
          {users.map((user) => (
            <tr class="text-[13.5px] align-top">
              <td class="px-5 py-4">
                <p class="text-ink">{user.full_name ?? '—'}</p>
                <p class="mt-0.5 text-[12px] text-ink-muted">{user.email}</p>
              </td>
              <td class="px-5 py-4">
                <span class:list={[
                  'badge',
                  user.kyc_status === 'approved' ? 'border-ink text-ink' : 'border-stone-dark text-ink-muted',
                ]}>
                  {KYC_LABEL[user.kyc_status] ?? user.kyc_status}
                </span>
              </td>
              <td class="px-5 py-4 text-ink-muted">
                {user.membership_tier === 'none' ? '—' : user.membership_tier}
              </td>
              <td class="px-5 py-4 text-ink-muted">{formatDate(user.created_at)}</td>
              <td class="px-5 py-4">
                <div class="flex justify-end">
                  <UserRowActions
                    client:visible
                    userId={user.id}
                    currentUserId={session.userId}
                    role={user.role}
                    isSuspended={user.is_suspended}
                  />
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardShell>
