---
import DashboardShell from '../../../components/private/DashboardShell.astro';
import LeadDetailPanel from '../../../components/islands/LeadDetailPanel.tsx';
import { formatDate, formatUsd } from '@luxus/shared';
import { requireRole } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = requireRole(Astro, 'admin');
if (guard instanceof Response) return guard;
const session = guard;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/crm', 302);

interface LeadDetail {
  lead: {
    id: string; kind: string; stage: string; name: string; email: string | null;
    phone: string | null; company: string | null; category: string | null;
    estimated_value: number | null; source: string | null; message: string | null;
    assigned_to: string | null; next_action: string | null; next_action_at: string | null;
    created_at: string; asset_id: string | null;
  };
  notes: { id: string; body: string; created_at: string; author: { full_name: string | null } | null }[];
}

let detail: LeadDetail;
try {
  detail = await apiFetch<LeadDetail>(`/v1/crm/leads/${id}`, { token: session.accessToken });
} catch {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { lead, notes } = detail;

const { data: staff } = await Astro.locals.supabase
  .from('profiles')
  .select('id, full_name, email')
  .eq('role', 'admin')
  .order('full_name');
---

<DashboardShell title={lead.name} session={session}>
  <div class="mb-8">
    <nav aria-label="Migas de pan" class="mb-6">
      <ol class="flex items-center gap-2 text-[11px] uppercase tracking-luxus text-ink-muted">
        <li><a href={`/admin/crm?kind=${lead.kind}`} class="link-underline">CRM</a></li>
        <li aria-hidden="true">·</li>
        <li aria-current="page" class="text-ink">{lead.name}</li>
      </ol>
    </nav>

    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="text-[11px] uppercase tracking-luxus text-gold-dark">
          {lead.kind === 'seller_pipeline' ? 'Captación de vendedor' : 'Consulta de comprador'}
        </p>
        <h1 class="mt-2 font-display text-[32px] leading-tight">{lead.name}</h1>
        <p class="mt-2 text-[13px] text-ink-muted">
          {lead.email} {lead.phone && `· ${lead.phone}`} {lead.company && `· ${lead.company}`}
        </p>
      </div>
      <p class="text-[12px] uppercase tracking-luxus text-ink-muted/70">
        Creado {formatDate(lead.created_at)}
      </p>
    </div>

    {(lead.category || lead.estimated_value || lead.source) && (
      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 border-t border-stone pt-5 text-[13px]">
        {lead.category && (
          <div class="flex gap-2"><dt class="text-ink-muted">Categoría</dt><dd>{lead.category}</dd></div>
        )}
        {lead.estimated_value && (
          <div class="flex gap-2"><dt class="text-ink-muted">Valor estimado</dt><dd>{formatUsd(lead.estimated_value)}</dd></div>
        )}
        {lead.source && (
          <div class="flex gap-2"><dt class="text-ink-muted">Origen</dt><dd>{lead.source}</dd></div>
        )}
      </dl>
    )}

    {lead.message && (
      <p class="mt-5 border-l-2 border-stone-dark bg-white px-5 py-4 text-[13.5px] leading-relaxed text-ink-muted">
        {lead.message}
      </p>
    )}
  </div>

  <LeadDetailPanel
    client:load
    leadId={lead.id}
    stage={lead.stage}
    assignedTo={lead.assigned_to}
    nextAction={lead.next_action}
    nextActionAt={lead.next_action_at}
    notes={notes}
    staff={staff ?? []}
  />
</DashboardShell>
