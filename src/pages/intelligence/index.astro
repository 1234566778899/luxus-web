---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { formatDate } from '@luxus/shared';
import { fetchPublishedArticles } from '../../lib/queries';

const articles = await fetchPublishedArticles(Astro.locals.supabase, 30);
const [lead, ...rest] = articles;

const isVerified = Astro.locals.session?.profile.kyc_status === 'approved';
---

<PublicLayout
  title="Intelligence"
  description="Análisis propio del mercado peruano de activos de alto patrimonio: precios, plazos de transacción y marco registral."
>
  <section class="border-b border-stone">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-eyebrow uppercase tracking-wider2 text-gold-dark">Intelligence</p>
        <h1 class="mt-5 font-display text-[42px] leading-tight sm:text-[54px]">
          Lectura del mercado
        </h1>
        <p class="mt-7 text-[16px] leading-relaxed text-ink-muted text-pretty">
          Reportes elaborados por el equipo de LUXUS a partir de las operaciones
          que acompañamos. Sin proyecciones de venta: precios observados, plazos
          reales y los obstáculos registrales que deciden si una transacción cierra.
        </p>
      </div>
    </div>
  </section>

  {articles.length === 0 ? (
    <section class="container-page py-24 text-center">
      <p class="font-display text-[26px]">Aún no hay reportes publicados</p>
      <p class="mt-4 text-[14px] text-ink-muted">Vuelva pronto.</p>
    </section>
  ) : (
    <>
      {lead && (
        <section class="container-page py-16" aria-label="Reporte destacado">
          <a href={`/intelligence/${lead.slug}`} class="group grid gap-10 lg:grid-cols-2 lg:items-center">
            <div class="aspect-[3/2] overflow-hidden bg-stone">
              <img
                src={`https://picsum.photos/seed/${lead.slug}/1400/933`}
                alt=""
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-luxus group-hover:scale-[1.03]"
              />
            </div>
            <div>
              <p class="eyebrow">
                {lead.category ?? 'Reporte'}
                {lead.is_members_only && <span class="ml-2 text-gold-dark">· Reservado</span>}
              </p>
              <h2 class="mt-4 font-display text-[32px] leading-tight sm:text-[40px]">
                <span class="link-underline">{lead.title}</span>
              </h2>
              {lead.subtitle && (
                <p class="mt-4 font-display text-[19px] italic text-ink-muted">{lead.subtitle}</p>
              )}
              <p class="mt-5 text-[15px] leading-relaxed text-ink-muted">{lead.excerpt}</p>
              <p class="mt-6 text-[12px] uppercase tracking-luxus text-ink-muted">
                {lead.author_name} · {formatDate(lead.published_at)} · {lead.reading_time} min
              </p>
            </div>
          </a>
        </section>
      )}

      {rest.length > 0 && (
        <section class="container-page pb-24" aria-label="Todos los reportes">
          <div class="grid gap-x-10 gap-y-14 border-t border-stone pt-14 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((article) => (
              <article class="group">
                <a href={`/intelligence/${article.slug}`}>
                  <div class="aspect-[3/2] overflow-hidden bg-stone">
                    <img
                      src={`https://picsum.photos/seed/${article.slug}/900/600`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-[900ms] ease-luxus group-hover:scale-[1.03]"
                    />
                  </div>
                  <p class="eyebrow mt-5">
                    {article.category ?? 'Reporte'}
                    {article.is_members_only && <span class="ml-2 text-gold-dark">· Reservado</span>}
                  </p>
                  <h3 class="mt-3 font-display text-[22px] leading-snug">
                    <span class="link-underline">{article.title}</span>
                  </h3>
                  <p class="mt-3 line-clamp-3 text-[14px] leading-relaxed text-ink-muted">
                    {article.excerpt}
                  </p>
                  <p class="mt-4 text-[12px] text-ink-muted/80">
                    {formatDate(article.published_at)} · {article.reading_time} min
                  </p>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  {!isVerified && (
    <section class="border-t border-stone bg-ivory">
      <div class="container-page py-20 text-center">
        <p class="text-eyebrow uppercase tracking-wider2 text-gold-dark">Reportes reservados</p>
        <h2 class="mx-auto mt-4 max-w-xl font-display text-[30px] leading-tight">
          Parte del análisis solo circula entre miembros verificados
        </h2>
        <p class="mx-auto mt-5 max-w-lg text-[15px] leading-relaxed text-ink-muted">
          Los reportes de inventario off-market y las lecturas de precio por
          operación no se publican abiertamente.
        </p>
        <a href="/private-access" class="btn-primary mt-9">Request Private Access</a>
      </div>
    </section>
  )}
</PublicLayout>
