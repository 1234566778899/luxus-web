---
import DashboardShell from '../../components/private/DashboardShell.astro';
import { formatDate } from '@luxus/shared';
import { requireSession } from '../../lib/auth';

const guard = requireSession(Astro);
if (guard instanceof Response) return guard;
const session = guard;

const supabase = Astro.locals.supabase;

const { data: ndas } = await supabase
  .from('ndas')
  .select(`
    id, status, signed_at, signed_sha256, template_version, expires_at,
    deals!ndas_deal_id_fkey (
      id, reference_code, stage,
      assets!deals_asset_id_fkey (title, slug, category)
    )
  `)
  .eq('status', 'signed')
  .order('signed_at', { ascending: false });

// Permisos vigentes del usuario: qué documentos puede abrir y hasta cuándo.
const { data: permissions } = await supabase
  .from('document_permissions')
  .select('id, level, granted_at, expires_at, revoked_at, deal_id, document_id, view_count, download_count')
  .is('revoked_at', null)
  .order('expires_at', { ascending: true, nullsFirst: false });

const signed = ndas ?? [];
const activePermissions = (permissions ?? []).filter(
  (p) => !p.expires_at || new Date(p.expires_at) > new Date(),
);
---

<DashboardShell title="NDAs y accesos" session={session} heading="NDAs firmados y accesos">
  <section aria-labelledby="ndas-title">
    <h2 id="ndas-title" class="font-display text-[24px]">Acuerdos de confidencialidad</h2>

    {signed.length === 0 ? (
      <p class="mt-5 border border-stone bg-white p-8 text-[14px] text-ink-muted">
        Aún no ha firmado ningún acuerdo de confidencialidad.
      </p>
    ) : (
      <ul class="mt-5 divide-y divide-stone border border-stone bg-white">
        {signed.map((nda) => {
          const deal = nda.deals as unknown as {
            id: string; reference_code: string;
            assets: { title: string; slug: string } | null;
          } | null;

          return (
            <li class="p-6">
              <div class="flex flex-wrap items-start justify-between gap-5">
                <div class="min-w-0">
                  <p class="text-[11px] uppercase tracking-luxus text-ink-muted">
                    {deal?.reference_code} · {nda.template_version}
                  </p>
                  <p class="mt-2 font-display text-[19px] leading-snug">
                    {deal?.assets?.title ?? 'Activo retirado'}
                  </p>
                  <p class="mt-2 text-[13px] text-ink-muted">
                    Firmado el {formatDate(nda.signed_at)}
                    {nda.expires_at && <span>{' · vigente hasta ' + formatDate(nda.expires_at)}</span>}
                  </p>
                  {nda.signed_sha256 && (
                    <p class="mt-2 break-all font-mono text-[11px] text-ink-muted/70">
                      SHA-256 {nda.signed_sha256.slice(0, 32)}…
                    </p>
                  )}
                </div>

                {deal && (
                  <a href={`/deal/${deal.id}#nda`} class="btn-ghost shrink-0 px-5 py-2.5">
                    Ver documento
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <section class="mt-12" aria-labelledby="perms-title">
    <h2 id="perms-title" class="font-display text-[24px]">Accesos documentales vigentes</h2>
    <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-ink-muted">
      Cada permiso lo concede el vendedor con una fecha de vencimiento. Al
      cumplirse, el acceso se revoca automáticamente.
    </p>

    {activePermissions.length === 0 ? (
      <p class="mt-5 border border-stone bg-white p-8 text-[14px] text-ink-muted">
        No tiene accesos documentales vigentes.
      </p>
    ) : (
      <div class="mt-5 overflow-x-auto border border-stone bg-white">
        <table class="w-full min-w-[38rem] text-left">
          <caption class="sr-only">Permisos documentales vigentes</caption>
          <thead>
            <tr class="border-b border-stone text-[10px] uppercase tracking-luxus text-ink-muted">
              <th scope="col" class="px-5 py-3.5 font-normal">Deal</th>
              <th scope="col" class="px-5 py-3.5 font-normal">Nivel</th>
              <th scope="col" class="px-5 py-3.5 font-normal">Concedido</th>
              <th scope="col" class="px-5 py-3.5 font-normal">Vence</th>
              <th scope="col" class="px-5 py-3.5 font-normal">Accesos</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone">
            {activePermissions.map((permission) => {
              const daysLeft = permission.expires_at
                ? Math.ceil((new Date(permission.expires_at).getTime() - Date.now()) / 86_400_000)
                : null;
              const expiringSoon = daysLeft !== null && 7 >= daysLeft;
              const expiryLabel = expiringSoon
                ? formatDate(permission.expires_at) + ' · ' + daysLeft + ' d'
                : formatDate(permission.expires_at);
              const accessLabel =
                permission.view_count + ' vistas · ' + permission.download_count + ' descargas';

              return (
                <tr class="text-[13.5px]">
                  <td class="px-5 py-4">
                    <a href={`/deal/${permission.deal_id}#documents`} class="link-underline">
                      Abrir Deal Room
                    </a>
                  </td>
                  <td class="px-5 py-4">
                    <span class="badge border-stone-dark text-ink-muted">
                      {permission.level === 'download' ? 'Descarga' : 'Solo lectura'}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-ink-muted">{formatDate(permission.granted_at)}</td>
                  <td class="px-5 py-4">
                    {permission.expires_at ? (
                      <span class:list={[expiringSoon ? 'text-gold-dark' : 'text-ink-muted']}>
                        {expiryLabel}
                      </span>
                    ) : (
                      <span class="text-ink-muted">Sin vencimiento</span>
                    )}
                  </td>
                  <td class="px-5 py-4 text-ink-muted">{accessLabel}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</DashboardShell>
