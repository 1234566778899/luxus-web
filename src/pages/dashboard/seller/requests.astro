---
import DashboardShell from '../../../components/private/DashboardShell.astro';
import StageBadge from '../../../components/private/StageBadge.astro';
import DealDecision from '../../../components/islands/DealDecision.tsx';
import { formatDate, formatRelative } from '@luxus/shared';
import type { DealStage } from '@luxus/shared';
import { requireRole } from '../../../lib/auth';

const guard = requireRole(Astro, 'seller', 'broker', 'admin');
if (guard instanceof Response) return guard;
const session = guard;

const { data } = await Astro.locals.supabase
  .from('deals')
  .select(`
    id, reference_code, stage, request_message, intended_use, financing_type,
    proof_of_funds, requested_at, kyc_cleared_at, expires_at, decline_reason,
    assets!deals_asset_id_fkey (id, title, slug, category, district, region),
    buyer:profiles!deals_buyer_id_fkey (id, full_name, email, kyc_status, screening_status, membership_tier, country, city)
  `)
  .eq('seller_id', session.userId)
  .order('requested_at', { ascending: false });

const deals = data ?? [];
const pending = deals.filter((d) =>
  ['requested', 'kyc_review', 'seller_review'].includes(d.stage),
);
const resolved = deals.filter(
  (d) => !['requested', 'kyc_review', 'seller_review'].includes(d.stage),
);

type Row = (typeof deals)[number];

function buyerOf(deal: Row) {
  return deal.buyer as unknown as {
    id: string; full_name: string | null; email: string;
    kyc_status: string; screening_status: string;
    membership_tier: string; country: string | null; city: string | null;
  } | null;
}

function assetOf(deal: Row) {
  return deal.assets as unknown as {
    id: string; title: string; slug: string; district: string | null; region: string | null;
  } | null;
}

const MEMBERSHIP_LABEL: Record<string, string> = {
  none: 'Sin membresía',
  private: 'LUXUS PRIVATE',
  black: 'LUXUS BLACK',
  family_office: 'LUXUS FAMILY OFFICE',
};
---

<DashboardShell title="Solicitudes de acceso" session={session} heading="Solicitudes de Deal Room">
  <section aria-labelledby="pending-title">
    <h2 id="pending-title" class="font-display text-[24px]">
      Por revisar <span class="ml-2 text-[15px] text-ink-muted">({pending.length})</span>
    </h2>

    {pending.length === 0 ? (
      <p class="mt-5 border border-stone bg-white p-8 text-[14px] text-ink-muted">
        No tiene solicitudes pendientes. Le avisaremos por correo cuando llegue una.
      </p>
    ) : (
      <ul class="mt-5 space-y-4">
        {pending.map((deal) => {
          const buyer = buyerOf(deal);
          const asset = assetOf(deal);
          const kycOk = buyer?.kyc_status === 'approved' && buyer?.screening_status !== 'blocked';

          return (
            <li class="border border-stone bg-white">
              <div class="border-b border-stone p-6">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="text-[11px] uppercase tracking-luxus text-ink-muted">
                        {deal.reference_code}
                      </span>
                      <StageBadge stage={deal.stage as DealStage} />
                    </div>
                    <p class="mt-2.5 font-display text-[21px] leading-snug">
                      {asset?.title ?? 'Activo retirado'}
                    </p>
                    <p class="mt-1 text-[13px] text-ink-muted">
                      {[asset?.district, asset?.region].filter(Boolean).join(', ')}
                    </p>
                  </div>
                  <p class="shrink-0 text-[12px] text-ink-muted">
                    {formatRelative(deal.requested_at)}
                  </p>
                </div>
              </div>

              <div class="grid gap-8 p-6 lg:grid-cols-12">
                <!-- Perfil del comprador -->
                <div class="lg:col-span-4">
                  <h3 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Solicitante</h3>
                  <p class="mt-3 font-display text-[18px]">{buyer?.full_name ?? 'Sin nombre'}</p>
                  <p class="mt-1 text-[13px] text-ink-muted">{buyer?.email}</p>
                  <p class="mt-1 text-[13px] text-ink-muted">
                    {[buyer?.city, buyer?.country].filter(Boolean).join(', ')}
                  </p>

                  <div class="mt-4 flex flex-wrap gap-2">
                    <span class:list={[
                      'badge',
                      kycOk ? 'border-ink bg-ink text-white' : 'border-gold text-gold-dark',
                    ]}>
                      {kycOk ? 'KYC aprobado' : 'KYC pendiente'}
                    </span>
                    {buyer?.membership_tier !== 'none' && (
                      <span class="badge border-stone-dark text-ink-muted">
                        {MEMBERSHIP_LABEL[buyer?.membership_tier ?? 'none']}
                      </span>
                    )}
                    {deal.proof_of_funds && (
                      <span class="badge border-stone-dark text-ink-muted">
                        Acredita fondos
                      </span>
                    )}
                  </div>

                  <p class="mt-5 text-[12px] leading-relaxed text-ink-muted">
                    Por confidencialidad, no se muestra la documentación de
                    identidad del solicitante: LUXUS confirma únicamente el
                    resultado de la verificación.
                  </p>
                </div>

                <!-- Motivo -->
                <div class="lg:col-span-4">
                  <h3 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Motivo</h3>
                  <p class="mt-3 text-[14px] leading-relaxed text-ink">
                    {deal.request_message}
                  </p>
                  <dl class="mt-5 space-y-2 text-[13px]">
                    {deal.intended_use && (
                      <div class="flex gap-2">
                        <dt class="text-ink-muted">Uso previsto:</dt>
                        <dd>{deal.intended_use}</dd>
                      </div>
                    )}
                    <div class="flex gap-2">
                      <dt class="text-ink-muted">Financiación:</dt>
                      <dd>
                        {deal.financing_type === 'cash' ? 'Recursos propios'
                          : deal.financing_type === 'financed' ? 'Financiada' : 'Mixta'}
                      </dd>
                    </div>
                  </dl>
                </div>

                <!-- Decisión -->
                <div class="lg:col-span-4">
                  <h3 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Decisión</h3>
                  <div class="mt-3">
                    <DealDecision
                      client:visible
                      dealId={deal.id}
                      buyerVerified={kycOk}
                      assetTitle={asset?.title ?? ''}
                    />
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  {resolved.length > 0 && (
    <section class="mt-12" aria-labelledby="resolved-title">
      <h2 id="resolved-title" class="font-display text-[24px]">
        Resueltas <span class="ml-2 text-[15px] text-ink-muted">({resolved.length})</span>
      </h2>

      <ul class="mt-5 divide-y divide-stone border border-stone bg-white">
        {resolved.map((deal) => {
          const buyer = buyerOf(deal);
          const asset = assetOf(deal);
          return (
            <li>
              <a href={`/deal/${deal.id}`} class="flex flex-wrap items-center justify-between gap-4 p-5 transition-colors hover:bg-ivory">
                <div class="min-w-0">
                  <p class="text-[15px]">{asset?.title ?? 'Activo retirado'}</p>
                  <p class="mt-1 text-[12px] text-ink-muted">
                    {buyer?.full_name ?? buyer?.email} · {deal.reference_code} ·{' '}
                    {formatDate(deal.requested_at)}
                  </p>
                  {deal.decline_reason && (
                    <p class="mt-1.5 text-[12px] italic text-ink-muted">{deal.decline_reason}</p>
                  )}
                </div>
                <StageBadge stage={deal.stage as DealStage} />
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</DashboardShell>
