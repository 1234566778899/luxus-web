---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ComplaintBookForm from '../../components/islands/ComplaintBookForm.tsx';
import { BRAND } from '@luxus/shared';
---

<PublicLayout
  title="Libro de Reclamaciones"
  description="Hoja de reclamación virtual de LUXUS PERÚ, conforme al Código de Protección y Defensa del Consumidor."
>
  <section class="border-b border-stone bg-ivory">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-eyebrow uppercase tracking-wider2 text-gold-dark">Protección al consumidor</p>
        <h1 class="mt-5 font-display text-[42px] leading-tight sm:text-[54px]">
          Libro de Reclamaciones
        </h1>
        <p class="mt-7 text-[16px] leading-relaxed text-ink-muted text-pretty">
          Este establecimiento cuenta con un Libro de Reclamaciones a su
          disposición. Formular un reclamo no impide acudir a otras vías de
          solución de controversias ni es requisito previo para interponer
          una denuncia ante INDECOPI.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <ComplaintBookForm client:load />
      </div>

      <aside class="lg:col-span-5">
        <div class="sticky top-24 space-y-10">
          <div class="border border-stone bg-white p-8">
            <h2 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Identificación del proveedor</h2>
            <dl class="mt-5 space-y-4 text-[14px] leading-relaxed">
              <div>
                <dt class="text-ink-muted">Razón social</dt>
                <dd class="mt-1 text-ink">{BRAND.legalName}</dd>
              </div>
              <div>
                <dt class="text-ink-muted">RUC</dt>
                <dd class="mt-1 text-ink">{BRAND.ruc}</dd>
              </div>
              <div>
                <dt class="text-ink-muted">Domicilio</dt>
                <dd class="mt-1 text-ink">{BRAND.address}</dd>
              </div>
            </dl>
          </div>

          <div>
            <h2 class="font-display text-[22px]">Reclamo o queja</h2>
            <p class="mt-4 text-[14px] leading-relaxed text-ink-muted">
              <strong class="text-ink">Reclamo:</strong> disconformidad
              relacionada con el bien o servicio contratado.
            </p>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">
              <strong class="text-ink">Queja:</strong> disconformidad no
              relacionada con el bien o servicio, o malestar respecto a la
              atención recibida.
            </p>
          </div>

          <div class="border border-stone bg-ivory p-8">
            <p class="text-[13px] leading-relaxed text-ink-muted">
              Al registrar su reclamo o queja recibirá un número
              correlativo y una constancia por correo electrónico. Le
              responderemos en un plazo no mayor a 30 días calendario,
              conforme al Código de Protección y Defensa del Consumidor (Ley
              N.º 29571) y su reglamento (D.S. N.º 011-2011-PCM y
              modificatorias).
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</PublicLayout>
