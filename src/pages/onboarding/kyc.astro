---
import DashboardShell from '../../components/private/DashboardShell.astro';
import KycWizard from '../../components/islands/KycWizard.tsx';
import { requireSession } from '../../lib/auth';

const guard = requireSession(Astro);
if (guard instanceof Response) return guard;
const session = guard;

// Último caso del usuario, para reanudar el wizard sin reescribir datos.
const { data: kycCase } = await Astro.locals.supabase
  .from('kyc_cases')
  .select('legal_name, document_type, document_number, nationality, birth_date, tax_residence, occupation, status, rejection_reason')
  .eq('user_id', session.userId)
  .order('created_at', { ascending: false })
  .limit(1)
  .maybeSingle();

const required = Astro.url.searchParams.get('required') === '1';
---

<DashboardShell title="Verificación de identidad" session={session}>
  <div class="mb-8">
    <p class="text-eyebrow uppercase tracking-wider2 text-gold-dark">Onboarding</p>
    <h1 class="mt-3 font-display text-[32px] leading-tight">Verificación de identidad</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink-muted">
      Requisito para acceder a la información de Nivel II y para solicitar
      acceso a cualquier Deal Room. El proceso toma unos minutos.
    </p>
  </div>

  {required && (
    <p class="mb-8 border-l-2 border-gold bg-white px-5 py-4 text-[14px] leading-relaxed text-ink">
      La página que intentó abrir requiere verificación completada.
    </p>
  )}

  {kycCase?.status === 'rejected' && kycCase.rejection_reason && (
    <div class="mb-8 border-l-2 border-red-700 bg-white px-5 py-4">
      <p class="text-[12px] uppercase tracking-luxus text-red-800">Intento anterior no aprobado</p>
      <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">{kycCase.rejection_reason}</p>
    </div>
  )}

  <div class="grid gap-8 xl:grid-cols-12">
    <div class="xl:col-span-8">
      <KycWizard
        client:load
        status={session.profile.kyc_status}
        existing={kycCase}
        fullName={session.profile.full_name ?? ''}
      />
    </div>

    <aside class="xl:col-span-4">
      <div class="space-y-6 xl:sticky xl:top-24">
        <div class="border border-stone bg-white p-7">
          <h2 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Por qué lo pedimos</h2>
          <p class="mt-4 text-[13.5px] leading-relaxed text-ink-muted">
            La normativa peruana de prevención del lavado de activos exige
            conocer al cliente y el origen de sus fondos antes de facilitar
            información reservada sobre activos de alto valor.
          </p>
          <p class="mt-4 text-[13.5px] leading-relaxed text-ink-muted">
            El vendedor nunca ve su documentación de identidad: solo recibe la
            confirmación de que la verificación fue aprobada.
          </p>
        </div>

        <div class="border border-stone bg-white p-7">
          <h2 class="text-eyebrow uppercase tracking-luxus text-ink-muted">Tratamiento de sus datos</h2>
          <ul class="mt-4 space-y-3 text-[13px] leading-relaxed text-ink-muted">
            <li class="flex gap-2.5"><span aria-hidden="true" class="text-gold-dark">—</span>Almacenados cifrados en repositorio privado.</li>
            <li class="flex gap-2.5"><span aria-hidden="true" class="text-gold-dark">—</span>Accesibles solo por el equipo de cumplimiento.</li>
            <li class="flex gap-2.5"><span aria-hidden="true" class="text-gold-dark">—</span>Conservados según los plazos legales aplicables.</li>
            <li class="flex gap-2.5"><span aria-hidden="true" class="text-gold-dark">—</span>Puede ejercer sus derechos ARCO en cualquier momento.</li>
          </ul>
          <a href="/legal/privacy" class="link-underline mt-5 inline-block text-[12px] uppercase tracking-luxus">
            Política de privacidad →
          </a>
        </div>

        <div class="border border-gold bg-white p-7">
          <p class="text-[12.5px] leading-relaxed text-ink-muted">
            En este entorno la verificación de identidad y el screening operan
            con un proveedor simulado. No constituyen verificación real.
          </p>
        </div>
      </div>
    </aside>
  </div>
</DashboardShell>
