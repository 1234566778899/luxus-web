---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../ui/Logo.astro';
import NotificationBell from '../islands/NotificationBell.tsx';
import type { SessionContext } from '../../lib/auth';

interface NavItem {
  href: string;
  label: string;
  badge?: number;
}

interface Props {
  title: string;
  heading?: string;
  session: SessionContext;
  nav?: NavItem[];
}

const { title, heading, session, nav } = Astro.props;
const path = Astro.url.pathname;
const profile = session.profile;

const roleLabel = {
  buyer: 'Comprador',
  seller: 'Vendedor',
  broker: 'Bróker',
  admin: 'Administración',
}[profile.role];

// Cada rol ve su propia navegación; el admin ve la suya completa.
const defaultNav: NavItem[] =
  profile.role === 'admin'
    ? [
        { href: '/admin', label: 'Resumen' },
        { href: '/admin/access-requests', label: 'Solicitudes' },
        { href: '/admin/assets', label: 'Verificación' },
        { href: '/admin/kyc', label: 'KYC y screening' },
        { href: '/admin/users', label: 'Usuarios' },
        { href: '/admin/intelligence', label: 'Intelligence' },
        { href: '/admin/crm', label: 'CRM' },
        { href: '/admin/complaint-book', label: 'Libro de Reclamaciones' },
        { href: '/admin/audit', label: 'Auditoría' },
      ]
    : profile.role === 'seller' || profile.role === 'broker'
      ? [
          { href: '/dashboard', label: 'Resumen' },
          { href: '/dashboard/seller/assets', label: 'Mis activos' },
          { href: '/dashboard/seller/requests', label: 'Solicitudes' },
          { href: '/dashboard/deals', label: 'Deal Rooms' },
          { href: '/dashboard/billing', label: 'Facturación' },
          { href: '/dashboard/settings', label: 'Cuenta' },
        ]
      : [
          { href: '/dashboard', label: 'Resumen' },
          { href: '/dashboard/deals', label: 'Deal Rooms' },
          { href: '/dashboard/watchlist', label: 'Seguimiento' },
          { href: '/dashboard/documents', label: 'NDAs firmados' },
          { href: '/dashboard/billing', label: 'Facturación' },
          { href: '/dashboard/settings', label: 'Cuenta' },
        ];

const items = nav ?? defaultNav;

const kycNeedsAttention =
  profile.role !== 'admin' && profile.kyc_status !== 'approved';
---

<BaseLayout title={title} noindex bodyClass="bg-ivory">
  <div class="min-h-screen">
    <header class="sticky top-0 z-40 border-b border-stone bg-white">
      <div class="container-page">
        <div class="flex h-[68px] items-center justify-between gap-6">
          <div class="flex items-center gap-8">
            <Logo size="sm" href="/" />
            <span class="hidden text-[10px] uppercase tracking-luxus text-ink-muted sm:inline">
              {roleLabel}
            </span>
          </div>

          <div class="flex items-center gap-5">
            <NotificationBell client:idle />
            <a href="/" class="hidden text-[11px] uppercase tracking-luxus text-ink-muted hover:text-ink sm:inline">
              Ver sitio
            </a>
            <form method="POST" action="/auth/signout">
              <button type="submit" class="text-[11px] uppercase tracking-luxus text-ink-muted hover:text-ink">
                Salir
              </button>
            </form>
          </div>
        </div>
      </div>
    </header>

    <div class="container-page py-10">
      <div class="grid gap-10 lg:grid-cols-12">
        <!-- Navegación lateral -->
        <nav class="lg:col-span-3 xl:col-span-2" aria-label="Navegación de la zona privada">
          <div class="lg:sticky lg:top-24">
            <div class="mb-6 border border-stone bg-white p-5">
              <p class="truncate font-display text-[17px]">{profile.full_name ?? profile.email}</p>
              <p class="mt-1 truncate text-[12px] text-ink-muted">{profile.email}</p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                <span class:list={[
                  'badge text-[9px]',
                  profile.kyc_status === 'approved'
                    ? 'border-ink/25 text-ink'
                    : 'border-gold text-gold-dark',
                ]}>
                  {profile.kyc_status === 'approved' ? 'Verificado' : 'Sin verificar'}
                </span>
                {profile.membership_tier !== 'none' && (
                  <span class="badge border-ink bg-ink text-[9px] text-white">
                    {profile.membership_tier === 'black' ? 'Black'
                      : profile.membership_tier === 'family_office' ? 'Family Office' : 'Private'}
                  </span>
                )}
              </div>
            </div>

            <ul class="space-y-0.5" role="list">
              {items.map((item) => {
                const active = item.href === '/dashboard' || item.href === '/admin'
                  ? path === item.href
                  : path.startsWith(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'flex items-center justify-between px-4 py-2.5 text-[13px] transition-colors',
                        active ? 'bg-ink text-white' : 'text-ink-muted hover:bg-white hover:text-ink',
                      ]}
                    >
                      {item.label}
                      {item.badge !== undefined && item.badge > 0 && (
                        <span class:list={[
                          'ml-2 inline-flex h-[18px] min-w-[18px] items-center justify-center px-1 text-[10px]',
                          active ? 'bg-white/20 text-white' : 'bg-gold text-ink',
                        ]}>
                          {item.badge}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>

            {kycNeedsAttention && (
              <a href="/onboarding/kyc" class="mt-6 block border border-gold bg-white p-5">
                <p class="text-eyebrow uppercase tracking-luxus text-gold-dark">Acción requerida</p>
                <p class="mt-2 text-[13px] leading-relaxed text-ink-muted">
                  Complete la verificación de identidad para acceder a la
                  información de Nivel II.
                </p>
                <p class="mt-3 text-[11px] uppercase tracking-luxus text-ink">Continuar →</p>
              </a>
            )}
          </div>
        </nav>

        <!-- Contenido -->
        <main id="main" class="lg:col-span-9 xl:col-span-10">
          {heading && (
            <h1 class="mb-8 font-display text-[32px] leading-tight">{heading}</h1>
          )}
          <slot />
        </main>
      </div>
    </div>
  </div>
</BaseLayout>
