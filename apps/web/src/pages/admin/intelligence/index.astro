---
import DashboardShell from '../../../components/private/DashboardShell.astro';
import { formatDate } from '@luxus/shared';
import { requireRole } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = requireRole(Astro, 'admin');
if (guard instanceof Response) return guard;
const session = guard;

interface Article {
  id: string;
  slug: string;
  title: string;
  category: string | null;
  status: string;
  is_members_only: boolean;
  author_name: string | null;
  published_at: string | null;
  updated_at: string;
}

let articles: Article[] = [];
try {
  const data = await apiFetch<{ articles: Article[] }>('/v1/admin/articles', {
    token: session.accessToken,
  });
  articles = data.articles;
} catch {
  articles = [];
}

const STATUS_LABEL: Record<string, string> = {
  draft: 'Borrador', review: 'En revisión', published: 'Publicado', archived: 'Archivado',
};
---

<DashboardShell title="Intelligence · CMS" session={session}>
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-[32px] leading-tight">Intelligence</h1>
      <p class="mt-2 text-[14px] text-ink-muted">Reportes de mercado del sitio público.</p>
    </div>
    <a href="/admin/intelligence/new" class="btn-primary">Nuevo artículo</a>
  </div>

  {articles.length === 0 ? (
    <p class="border border-stone bg-white p-8 text-[14px] text-ink-muted">Sin artículos todavía.</p>
  ) : (
    <ul class="divide-y divide-stone border border-stone bg-white">
      {articles.map((article) => (
        <li>
          <a href={`/admin/intelligence/${article.id}`} class="flex flex-wrap items-center justify-between gap-4 p-5 transition-colors hover:bg-ivory">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-3">
                <span class:list={[
                  'badge',
                  article.status === 'published' ? 'border-ink bg-ink text-white' : 'border-stone-dark text-ink-muted',
                ]}>
                  {STATUS_LABEL[article.status] ?? article.status}
                </span>
                {article.is_members_only && (
                  <span class="badge border-gold text-gold-dark">Reservado</span>
                )}
                {article.category && (
                  <span class="text-[11px] uppercase tracking-luxus text-ink-muted">{article.category}</span>
                )}
              </div>
              <p class="mt-2 font-display text-[19px] leading-snug">{article.title}</p>
              <p class="mt-1 text-[12px] text-ink-muted">
                {article.author_name ?? '—'} · Actualizado {formatDate(article.updated_at)}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</DashboardShell>
