---
import DashboardShell from '../../components/private/DashboardShell.astro';
import KycDecisionReview from '../../components/islands/KycDecisionReview.tsx';
import { formatDate } from '@luxus/shared';
import { requireRole } from '../../lib/auth';
import { apiFetch } from '../../lib/api';

const guard = requireRole(Astro, 'admin');
if (guard instanceof Response) return guard;
const session = guard;

interface KycCase {
  id: string;
  user_id: string;
  status: string;
  legal_name: string | null;
  document_type: string | null;
  document_number: string | null;
  nationality: string | null;
  tax_residence: string | null;
  occupation: string | null;
  is_pep: boolean | null;
  pep_details: string | null;
  source_of_funds: string | null;
  source_of_wealth: string | null;
  estimated_net_worth_band: string | null;
  submitted_at: string | null;
  requires_manual_review: boolean;
  profiles: { id: string; full_name: string | null; email: string; role: string } | null;
}

let cases: KycCase[] = [];
try {
  const data = await apiFetch<{ cases: KycCase[] }>('/v1/admin/kyc/queue', {
    token: session.accessToken,
  });
  cases = data.cases;
} catch {
  cases = [];
}
---

<DashboardShell title="KYC y screening" session={session}>
  <div class="mb-8">
    <h1 class="font-display text-[32px] leading-tight">Revisión manual de KYC</h1>
    <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-ink-muted">
      Casos que el proveedor no pudo resolver automáticamente: documentación
      insuficiente, declaración PEP o coincidencias que requieren criterio humano.
    </p>
  </div>

  {cases.length === 0 ? (
    <p class="border border-stone bg-white p-8 text-[14px] text-ink-muted">
      No hay expedientes en revisión manual.
    </p>
  ) : (
    <ul class="space-y-6">
      {cases.map((c) => (
        <li class="border border-stone bg-white p-6">
          <div class="grid gap-8 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="text-[11px] uppercase tracking-luxus text-gold-dark">
                {c.status === 'submitted' ? 'Enviado' : 'En revisión'}
                {c.requires_manual_review && ' · Revisión requerida'}
              </p>
              <p class="mt-2 font-display text-[19px]">{c.legal_name ?? c.profiles?.full_name}</p>
              <p class="mt-1 text-[13px] text-ink-muted">{c.profiles?.email}</p>
              <p class="mt-1 text-[13px] text-ink-muted">
                {c.document_type} · {c.document_number} · {c.nationality}
              </p>
              <p class="mt-3 text-[11px] uppercase tracking-luxus text-ink-muted/70">
                Enviado {c.submitted_at ? formatDate(c.submitted_at) : '—'}
              </p>
            </div>

            <div class="lg:col-span-4">
              <dl class="space-y-2.5 text-[13px]">
                <div>
                  <dt class="text-ink-muted">Residencia fiscal / ocupación</dt>
                  <dd>{c.tax_residence} · {c.occupation}</dd>
                </div>
                <div>
                  <dt class="text-ink-muted">Persona expuesta políticamente</dt>
                  <dd>{c.is_pep ? `Sí — ${c.pep_details ?? ''}` : 'No'}</dd>
                </div>
                <div>
                  <dt class="text-ink-muted">Patrimonio estimado</dt>
                  <dd>{c.estimated_net_worth_band ?? '—'}</dd>
                </div>
                <div>
                  <dt class="text-ink-muted">Origen de fondos</dt>
                  <dd class="leading-relaxed">{c.source_of_funds}</dd>
                </div>
                <div>
                  <dt class="text-ink-muted">Origen del patrimonio</dt>
                  <dd class="leading-relaxed">{c.source_of_wealth}</dd>
                </div>
              </dl>
            </div>

            <div class="lg:col-span-4">
              <KycDecisionReview client:visible caseId={c.id} userId={c.user_id} />
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}
</DashboardShell>
