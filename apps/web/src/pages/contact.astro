---
import PublicLayout from '../layouts/PublicLayout.astro';
import { BRAND } from '@luxus/shared';
---

<PublicLayout
  title="Contacto"
  description="Contacte con el equipo de LUXUS PERÚ. Oficina en San Isidro, Lima."
>
  <section class="container-page py-16 lg:py-24">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-eyebrow uppercase tracking-wider2 text-gold-dark">Contacto</p>
        <h1 class="mt-5 font-display text-[42px] leading-tight sm:text-[52px]">Hablemos en privado</h1>
        <p class="mt-7 text-[16px] leading-relaxed text-ink-muted text-pretty">
          Atendemos consultas de compradores, family offices, propietarios y
          asesores. Toda comunicación se trata bajo reserva.
        </p>

        <dl class="mt-12 space-y-8">
          <div>
            <dt class="text-eyebrow uppercase tracking-luxus text-ink-muted">Oficina</dt>
            <dd class="mt-2 text-[15px] leading-relaxed">{BRAND.address}</dd>
          </div>
          <div>
            <dt class="text-eyebrow uppercase tracking-luxus text-ink-muted">Correo</dt>
            <dd class="mt-2 text-[15px]">
              <a href={`mailto:${BRAND.email}`} class="link-underline">{BRAND.email}</a>
            </dd>
          </div>
          <div>
            <dt class="text-eyebrow uppercase tracking-luxus text-ink-muted">Teléfono</dt>
            <dd class="mt-2 text-[15px]">
              <a href={`tel:${BRAND.phone.replace(/\s/g, '')}`} class="link-underline">{BRAND.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="text-eyebrow uppercase tracking-luxus text-ink-muted">Protección de datos</dt>
            <dd class="mt-2 text-[15px]">
              <a href="mailto:privacidad@luxusperu.com" class="link-underline">privacidad@luxusperu.com</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="space-y-4">
          <a href="/private-access" class="group block border border-ink p-8 transition-colors hover:bg-ink hover:text-white">
            <p class="text-eyebrow uppercase tracking-luxus opacity-60">Compradores y family offices</p>
            <p class="mt-3 font-display text-[24px]">Solicitar acceso privado</p>
            <p class="mt-3 text-[14px] leading-relaxed opacity-70">
              Admisión evaluada individualmente, con verificación de identidad.
            </p>
            <p class="mt-5 text-[11px] uppercase tracking-luxus">Continuar →</p>
          </a>

          <a href="/sell" class="group block border border-stone p-8 transition-colors hover:border-ink">
            <p class="text-eyebrow uppercase tracking-luxus text-ink-muted">Propietarios y brókers</p>
            <p class="mt-3 font-display text-[24px]">Presentar un activo</p>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">
              Evaluamos titularidad y situación registral antes de publicar.
            </p>
            <p class="mt-5 text-[11px] uppercase tracking-luxus text-ink">Continuar →</p>
          </a>

          <div class="border border-stone bg-ivory p-8">
            <p class="text-[13px] leading-relaxed text-ink-muted">
              LUXUS PERÚ no presta servicios financieros ni de asesoría legal o
              tributaria. La información publicada no constituye recomendación de
              inversión.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
