---
import DashboardShell from '../../components/private/DashboardShell.astro';
import StatCard from '../../components/private/StatCard.astro';
import StageBadge from '../../components/private/StageBadge.astro';
import {
  DEAL_STAGE_META, TERMINAL_DEAL_STAGES, formatDate, formatPriceRange, formatRelative,
} from '@luxus/shared';
import type { DealStage } from '@luxus/shared';
import { requireSession } from '../../lib/auth';

const guard = requireSession(Astro);
if (guard instanceof Response) return guard;
const session = guard;

const supabase = Astro.locals.supabase;
const profile = session.profile;
const isSellSide = profile.role === 'seller' || profile.role === 'broker';

// Todas estas lecturas pasan por RLS con la sesión del usuario: solo devuelven
// lo que le corresponde, sin filtrar por id en el código.
const [dealsResult, watchlistResult, ndasResult, assetsResult, requestsResult] =
  await Promise.all([
    supabase
      .from('deals')
      .select(`
        id, reference_code, stage, stage_changed_at, requested_at, expires_at, buyer_id, seller_id,
        assets!deals_asset_id_fkey (title, slug, category, district, region, price_min, price_max, price_on_request)
      `)
      .order('stage_changed_at', { ascending: false })
      .limit(10),
    supabase
      .from('watchlist')
      .select(`
        asset_id, created_at,
        assets!watchlist_asset_id_fkey (title, slug, category, district, region, price_min, price_max, price_on_request)
      `)
      .order('created_at', { ascending: false })
      .limit(4),
    supabase
      .from('ndas')
      .select('id, signed_at, status')
      .eq('status', 'signed'),
    isSellSide
      ? supabase.from('assets').select('id, status').eq('owner_id', profile.id)
      : Promise.resolve({ data: [] }),
    isSellSide
      ? supabase
          .from('deals')
          .select('id, stage')
          .eq('seller_id', profile.id)
          .in('stage', ['requested', 'kyc_review', 'seller_review'])
      : Promise.resolve({ data: [] }),
  ]);

const deals = dealsResult.data ?? [];
const myDeals = deals.filter((d) => d.buyer_id === profile.id);
const activeDeals = deals.filter((d) => !TERMINAL_DEAL_STAGES.includes(d.stage as DealStage));
const pendingRequests = requestsResult.data ?? [];
const myAssets = assetsResult.data ?? [];
const publishedAssets = myAssets.filter((a) => a.status === 'published');

const kycLabel = {
  not_started: 'Sin iniciar',
  in_progress: 'En curso',
  submitted: 'Enviada',
  in_review: 'En revisión',
  approved: 'Aprobada',
  rejected: 'Rechazada',
  expired: 'Caducada',
}[profile.kyc_status];

const greeting = profile.full_name?.split(' ')[0] ?? 'Bienvenido';
---

<DashboardShell title="Mi panel" session={session}>
  <div class="mb-9">
    <p class="text-eyebrow uppercase tracking-luxus text-ink-muted">
      {new Intl.DateTimeFormat('es-PE', { dateStyle: 'full' }).format(new Date())}
    </p>
    <h1 class="mt-3 font-display text-[34px] leading-tight">{greeting}</h1>
  </div>

  <!-- Métricas -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard
      label="Verificación"
      value={kycLabel}
      tone={profile.kyc_status === 'approved' ? 'default' : 'gold'}
      hint={profile.kyc_status === 'approved' ? 'Acceso Nivel II activo' : 'Requerida para Nivel II'}
      href={profile.kyc_status === 'approved' ? undefined : '/onboarding/kyc'}
    />
    <StatCard
      label="Deal Rooms activos"
      value={activeDeals.length}
      hint="Operaciones en curso"
      href="/dashboard/deals"
    />
    {isSellSide ? (
      <>
        <StatCard
          label="Activos publicados"
          value={publishedAssets.length}
          hint={`${myAssets.length} en total`}
          href="/dashboard/seller/assets"
        />
        <StatCard
          label="Solicitudes por revisar"
          value={pendingRequests.length}
          tone={pendingRequests.length > 0 ? 'gold' : 'default'}
          hint="Esperan su decisión"
          href="/dashboard/seller/requests"
        />
      </>
    ) : (
      <>
        <StatCard
          label="En seguimiento"
          value={(watchlistResult.data ?? []).length}
          hint="Activos guardados"
          href="/dashboard/watchlist"
        />
        <StatCard
          label="NDAs firmados"
          value={(ndasResult.data ?? []).length}
          hint="Acuerdos vigentes"
          href="/dashboard/documents"
        />
      </>
    )}
  </div>

  <!-- Aviso de verificación -->
  {profile.kyc_status !== 'approved' && profile.role !== 'admin' && (
    <div class="mt-8 border border-gold bg-white p-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="max-w-xl">
          <p class="text-eyebrow uppercase tracking-luxus text-gold-dark">Acceso limitado</p>
          <h2 class="mt-3 font-display text-[24px]">Complete su verificación</h2>
          <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">
            Sin verificación solo puede consultar la información pública:
            categoría, distrito aproximado y rango de precio. El precio de
            referencia, la ubicación real y los Deal Rooms requieren KYC aprobado.
          </p>
        </div>
        <a href="/onboarding/kyc" class="btn-primary shrink-0">Verificar identidad</a>
      </div>
    </div>
  )}

  <!-- Deal Rooms -->
  <section class="mt-12" aria-labelledby="deals-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="deals-title" class="font-display text-[26px]">
        {isSellSide ? 'Operaciones' : 'Mis Deal Rooms'}
      </h2>
      <a href="/dashboard/deals" class="link-underline text-[11px] uppercase tracking-luxus">
        Ver todos →
      </a>
    </div>

    {deals.length === 0 ? (
      <div class="mt-6 border border-stone bg-white p-10 text-center">
        <p class="font-display text-[21px]">Sin operaciones activas</p>
        <p class="mx-auto mt-3 max-w-md text-[14px] leading-relaxed text-ink-muted">
          {isSellSide
            ? 'Cuando un comprador verificado solicite acceso a uno de sus activos, aparecerá aquí.'
            : 'Explore las colecciones y solicite acceso al Deal Room de los activos que le interesen.'}
        </p>
        <a href={isSellSide ? '/dashboard/seller/assets' : '/collection/real-estate'} class="btn-outline mt-7">
          {isSellSide ? 'Gestionar mis activos' : 'Explorar colecciones'}
        </a>
      </div>
    ) : (
      <ul class="mt-6 divide-y divide-stone border border-stone bg-white">
        {deals.map((deal) => {
          const asset = deal.assets as unknown as {
            title: string; slug: string; category: string; district: string | null;
            region: string | null; price_min: number | null; price_max: number | null;
            price_on_request: boolean;
          } | null;
          const meta = DEAL_STAGE_META[deal.stage as DealStage];
          const daysLeft = deal.expires_at
            ? Math.ceil((new Date(deal.expires_at).getTime() - Date.now()) / 86_400_000)
            : null;

          return (
            <li>
              <a href={`/deal/${deal.id}`} class="block p-6 transition-colors hover:bg-ivory">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="text-[11px] uppercase tracking-luxus text-ink-muted">
                        {deal.reference_code}
                      </span>
                      <StageBadge stage={deal.stage as DealStage} />
                      {deal.buyer_id === profile.id && isSellSide === false && (
                        <span class="text-[10px] uppercase tracking-luxus text-ink-muted/60">
                          Como comprador
                        </span>
                      )}
                    </div>

                    <p class="mt-2.5 font-display text-[20px] leading-snug">
                      {asset?.title ?? 'Activo retirado'}
                    </p>

                    <p class="mt-1.5 text-[13px] text-ink-muted">
                      {[asset?.district, asset?.region].filter(Boolean).join(', ')}
                      {asset && ` · ${formatPriceRange(asset)}`}
                    </p>

                    <p class="mt-2.5 text-[12.5px] leading-relaxed text-ink-muted">
                      {meta.description}
                    </p>
                  </div>

                  <div class="shrink-0 text-right">
                    <p class="text-[12px] text-ink-muted">
                      {formatRelative(deal.stage_changed_at)}
                    </p>
                    {daysLeft !== null && daysLeft <= 14 && daysLeft > 0 && (
                      <p class="mt-1.5 text-[11px] uppercase tracking-luxus text-gold-dark">
                        Vence en {daysLeft} d
                      </p>
                    )}
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <!-- Watchlist (compradores) -->
  {!isSellSide && (watchlistResult.data ?? []).length > 0 && (
    <section class="mt-12" aria-labelledby="watch-title">
      <div class="flex items-end justify-between gap-4">
        <h2 id="watch-title" class="font-display text-[26px]">En seguimiento</h2>
        <a href="/dashboard/watchlist" class="link-underline text-[11px] uppercase tracking-luxus">
          Ver todos →
        </a>
      </div>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {(watchlistResult.data ?? []).map((item) => {
          const asset = item.assets as unknown as {
            title: string; slug: string; district: string | null; region: string | null;
            price_min: number | null; price_max: number | null; price_on_request: boolean;
          } | null;
          if (!asset) return null;
          return (
            <li class="border border-stone bg-white p-6">
              <a href={`/asset/${asset.slug}`} class="block">
                <p class="font-display text-[19px] leading-snug">
                  <span class="link-underline">{asset.title}</span>
                </p>
                <p class="mt-2 text-[13px] text-ink-muted">
                  {[asset.district, asset.region].filter(Boolean).join(', ')}
                </p>
                <p class="mt-3 font-display text-[17px]">{formatPriceRange(asset)}</p>
                <p class="mt-2 text-[11px] uppercase tracking-luxus text-ink-muted/70">
                  Guardado {formatDate(item.created_at)}
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</DashboardShell>
