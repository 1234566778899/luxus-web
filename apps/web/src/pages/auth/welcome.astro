---
import AuthLayout from '../../layouts/AuthLayout.astro';
import ResetPasswordForm from '../../components/islands/ResetPasswordForm.tsx';
---

<AuthLayout
  title="Bienvenido a LUXUS PERÚ"
  heading="Su acceso ha sido aprobado"
  subheading="Establezca su contraseña para activar la cuenta. A continuación configurará la verificación en dos pasos."
>
  <ResetPasswordForm client:load invite />

  <div class="mt-10 border border-stone bg-ivory p-6">
    <p class="text-eyebrow uppercase tracking-luxus text-ink-muted">Siguientes pasos</p>
    <ol class="mt-4 space-y-2.5 text-[13.5px] leading-relaxed text-ink-muted">
      <li>1 · Establecer contraseña.</li>
      <li>2 · Activar la verificación en dos pasos.</li>
      <li>3 · Completar la verificación de identidad y origen de fondos.</li>
      <li>4 · Acceder a la información de Nivel II y solicitar Deal Rooms.</li>
    </ol>
  </div>
</AuthLayout>
