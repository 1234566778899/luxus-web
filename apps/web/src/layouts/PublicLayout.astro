---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import type { AssetCategory } from '@luxus/shared';

interface Props {
  title: string;
  description?: string;
  image?: string;
  transparentHeader?: boolean;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Página de colección: pone el buscador en el encabezado en vez del nav. */
  headerCategory?: AssetCategory;
  headerSearchValue?: string;
}

const { transparentHeader = false, headerCategory, headerSearchValue, ...seo } = Astro.props;
const session = Astro.locals.session;
---

<BaseLayout {...seo}>
  <div class="flex min-h-screen flex-col">
    <SiteHeader
      transparent={transparentHeader}
      session={session}
      category={headerCategory}
      searchValue={headerSearchValue}
    />
    {/* El header transparente mide 72px en móvil (solo la fila de marca +
        acceso) y 124px desde `lg:` (suma la fila de navegación/buscador,
        que en móvil vive en el menú aparte) — el offset negativo tiene que
        seguirle el paso en cada punto de quiebre para que el hero arranque
        justo debajo, sin hueco ni superposición. */}
    <main id="main" class:list={['flex-1', transparentHeader && '-mt-[72px] lg:-mt-[124px]']}>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
