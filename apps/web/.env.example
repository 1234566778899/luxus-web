# Copie este archivo a apps/web/.env y complete los valores.
# En Vercel: Project Settings → Environment Variables (una por variable).

# Supabase — proyecto (clave publishable, nunca la service_role aquí).
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de la API (Fastify), sin slash final.
# Local:      http://localhost:4000
# Producción: la URL que te da Railway para el servicio de la API.
PUBLIC_API_URL=http://localhost:4000

# URL pública de este sitio (Astro). La usa la propia app para construir
# metadatos (sitemap, OpenGraph, JSON-LD) y se la pasa a la API para que
# arme links en correos/callbacks — debe apuntar al dominio real en Vercel.
# Local:      http://localhost:4321
# Producción: la URL que te da Vercel para este proyecto.
PUBLIC_SITE_URL=http://localhost:4321

# Google Maps (Static + Embed API). Opcional: sin esta clave, los mapas
# caen a un marcador de posición dibujado a mano en vez de romper la página.
# Restrinja la clave por referrer HTTP en Google Cloud Console.
PUBLIC_GOOGLE_MAPS_API_KEY=
